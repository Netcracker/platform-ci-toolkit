# Baseline Super-Linter environment.
# Caller DEFAULT_BRANCH (docker -e / CI) is restored after this file loads (see run.sh).
# Optional consumer merges: prechecks/custom-liners/super-linter.env.

RUN_LOCAL=true
VALIDATE_ALL_CODEBASE=false
DEFAULT_BRANCH=master
LOG_LEVEL=INFO
ENABLE_GITHUB_ACTIONS_GROUP_TITLE=false

# Linter rules location inside the container.
LINTER_RULES_PATH=/tmp/platform-ci-toolkit/base-liners

# Exclude the Go module cache from linting. CI jobs place GOMODCACHE at .go/pkg/mod
# inside the checkout so it can be saved and restored.
# Super-Linter matches this against the full path (for example /tmp/lint/.go/...), so
# the pattern must not be anchored to the repository root. Keep the single quotes:
# this file is sourced by the shell.
FILTER_REGEX_EXCLUDE='(^|/)\.go/pkg/mod/.*'

# Allowlist: only the linters below run (matching files in the change set).
# Super-Linter does not allow a mix of VALIDATE_*=true and VALIDATE_*=false,
# so this file uses only explicit enables. Anything not listed is off.
# VALIDATE_CHECKOV=true
VALIDATE_DOCKERFILE_HADOLINT=true
VALIDATE_GO=true
VALIDATE_GO_MODULES=true
VALIDATE_JAVA=true
JAVA_FILE_NAME=.checkstyle.xml
# VALIDATE_KUBERNETES_KUBECONFORM=true
VALIDATE_MARKDOWN=true
VALIDATE_PYTHON_RUFF=true
VALIDATE_RENOVATE=true
VALIDATE_YAML=true
