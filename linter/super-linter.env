# Baseline Super-Linter environment.
# Caller DEFAULT_BRANCH (docker -e / CI) is restored after this file loads (see run.sh).
# Optional consumer merges: prechecks/custom-liners/super-linter.env.

RUN_LOCAL=true
VALIDATE_ALL_CODEBASE=false
DEFAULT_BRANCH=master
LOG_LEVEL=INFO
ENABLE_GITHUB_ACTIONS_GROUP_TITLE=false

# Linter rules location inside the container.
LINTER_RULES_PATH=/tmp/platform-ci-toolkit/base-liners

# Exclude the Go module cache from linting. CI jobs place GOMODCACHE at .go/pkg/mod
# inside the checkout so it can be saved and restored.
FILTER_REGEX_EXCLUDE=^\.go/pkg/mod/.*

# Allowlist: only the linters below run (matching files in the change set).
# Super-Linter does not allow a mix of VALIDATE_*=true and VALIDATE_*=false,
# so this file uses only explicit enables. Anything not listed is off.
VALIDATE_GO=true
VALIDATE_GO_MODULES=true
VALIDATE_GO_RELEASER=true
VALIDATE_JAVA=true
VALIDATE_GOOGLE_JAVA_FORMAT=true
VALIDATE_PYTHON_PYLINT=true
VALIDATE_PYTHON_FLAKE8=true
VALIDATE_PYTHON_BLACK=true
VALIDATE_PYTHON_ISORT=true
VALIDATE_PYTHON_MYPY=true
VALIDATE_PYTHON_RUFF=true
VALIDATE_PYTHON_RUFF_FORMAT=true
VALIDATE_YAML=true
VALIDATE_YAML_PRETTIER=true
VALIDATE_MARKDOWN=true
VALIDATE_MARKDOWN_PRETTIER=true
VALIDATE_DOCKERFILE_HADOLINT=true
VALIDATE_BASH=true
VALIDATE_BASH_EXEC=true
VALIDATE_SHELL_SHFMT=true
VALIDATE_JSON=true
VALIDATE_JSON_PRETTIER=true
VALIDATE_JSONC=true
VALIDATE_JSONC_PRETTIER=true
VALIDATE_GITLEAKS=true
VALIDATE_GIT_MERGE_CONFLICT_MARKERS=true
VALIDATE_GIT_COMMITLINT=true
VALIDATE_EDITORCONFIG=true
VALIDATE_ENV=true
VALIDATE_GITHUB_ACTIONS=true
VALIDATE_GITHUB_ACTIONS_ZIZMOR=true
VALIDATE_KUBERNETES_KUBECONFORM=true
VALIDATE_RENOVATE=true
VALIDATE_NATURAL_LANGUAGE=true
VALIDATE_SPELL_CODESPELL=true
VALIDATE_TRIVY=true
# Biome is intentionally not enabled: its format check overlaps with the Prettier validators and
# Super-Linter warns about conflicts.
