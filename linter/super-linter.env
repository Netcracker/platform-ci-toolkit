# Baseline Super-Linter environment.
# Caller DEFAULT_BRANCH (docker -e / CI) is restored after this file loads (see run.sh).
# Optional consumer merges: prechecks/custom-liners/super-linter.env.

RUN_LOCAL=true
VALIDATE_ALL_CODEBASE=false
DEFAULT_BRANCH=master
LOG_LEVEL=INFO
ENABLE_GITHUB_ACTIONS_GROUP_TITLE=false

# Linter rules location inside the container.
LINTER_RULES_PATH=/tmp/platform-ci-toolkit/base-liners

# Exclude the Go module cache from linting. GOMODCACHE is set to /tmp/lint/.go/pkg/mod
# so the cache can be saved and restored by CI systems.
FILTER_REGEX_EXCLUDE=^\.go/pkg/mod/.*

# Languages commonly not present or intentionally disabled.
# Super-Linter does not allow a mix of VALIDATE_*=true and VALIDATE_*=false,
# so this file uses only explicit disables. All other languages are auto-detected.
VALIDATE_CHECKOV=false
VALIDATE_CSS=false
VALIDATE_HTML=false
VALIDATE_JAVASCRIPT=false
VALIDATE_JSCPD=false
VALIDATE_TYPESCRIPT=false
VALIDATE_RUBY=false
VALIDATE_PERL=false
VALIDATE_PHP=false
VALIDATE_KOTLIN=false
VALIDATE_JAVA=false
VALIDATE_CLOJURE=false
VALIDATE_COFFEESCRIPT=false
VALIDATE_CSHARP=false
VALIDATE_DART=false
VALIDATE_GOOGLE_JAVA_FORMAT=false
VALIDATE_LATEX=false
VALIDATE_LUA=false
VALIDATE_OBJECTIVE_C=false
VALIDATE_R=false
VALIDATE_RUST=false
VALIDATE_SCALAFMT=false
VALIDATE_SNAKEMAKE=false
VALIDATE_SQL=false
VALIDATE_TERRAFORM=false
VALIDATE_XML=false
